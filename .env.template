# ========== DJANGO ==========
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# ========== DATABASE ==========
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# ========== GOOGLE OAUTH ==========
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-id
GOOGLE_OAUTH_SECRET=your-google-oauth-secret

# ========== GOOGLE SHEETS & DRIVE ==========
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials.json
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# ========== WAVESPEED API ==========
WAVESPEED_API_KEY=your-wavespeed-api-key

# ========== ALMACENAMIENTO PERMANENTE DE ESTILIZADOS (S3) ==========
# Los resultados de Wavespeed caducan a los 7 dias en su propio bucket.
# Sin estas variables, gradio-service bloquea el guardado en Registro con
# un error claro en vez de guardar una URL que va a caducar. Ver
# docs/06_WAVESPEED.md para el detalle y que credenciales/bucket se necesitan.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_DEFAULT_REGION=eu-west-1
# Opcional: si el bucket esta detras de un CDN/dominio propio
AWS_S3_PUBLIC_BASE_URL=

# ========== GRADIO ==========
GRADIO_SERVER_NAME=localhost
GRADIO_SERVER_PORT=7860

# ========== JWT ==========
JWT_SECRET=your-jwt-secret-key
JWT_ALGORITHM=HS256
