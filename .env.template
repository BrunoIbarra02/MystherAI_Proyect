# ========== DJANGO ==========
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# ========== DATABASE ==========
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# ========== GOOGLE OAUTH ==========
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-id
GOOGLE_OAUTH_SECRET=your-google-oauth-secret

# ========== GOOGLE SHEETS & DRIVE ==========
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials.json
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# ========== WAVESPEED API ==========
WAVESPEED_API_KEY=your-wavespeed-api-key

# ========== ALMACENAMIENTO PERMANENTE DE ESTILIZADOS (Supabase Storage) ==========
# Los resultados de Wavespeed caducan a los 7 dias en su propio bucket S3.
# Sin estas variables, gradio-service bloquea el guardado en Registro con
# un error claro en vez de guardar una URL que va a caducar. Es el MISMO
# proyecto Supabase que ya usa DATABASE_URL. Ver docs/06_WAVESPEED.md.
SUPABASE_URL=https://your-project-ref.supabase.co
# Clave "service_role" (NO "anon") -- Dashboard Supabase > Settings > API.
# Server-side only, nunca exponerla al frontend.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=estilizados

# ========== GRADIO ==========
GRADIO_SERVER_NAME=localhost
GRADIO_SERVER_PORT=7860

# ========== JWT ==========
JWT_SECRET=your-jwt-secret-key
JWT_ALGORITHM=HS256
